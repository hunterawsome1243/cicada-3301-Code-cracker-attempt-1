{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"${CLAUDE_ENV_FILE:-}\" ] && [ -d \"$CLAUDE_PROJECT_DIR/.venv/bin\" ] && echo \"export PATH=$CLAUDE_PROJECT_DIR/.venv/bin:\\$PATH\" >> \"$CLAUDE_ENV_FILE\"; exit 0"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/hooks/deny_frozen.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/hooks/stop_gate.sh",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
